    border: 1px solid #D1D1D6;
}

QGroupBox::title {
    color: #1D1D1F;
}

QLabel {
    color: #6E6E73;
}

QPushButton {
    background-color: #E8E8ED;
    color: #1D1D1F;
    border: 1px solid #D1D1D6;
}

QPushButton:hover {
    background-color: #D1D1D6;
}

QPushButton:pressed {
    background-color: #C7C7CC;
}

QPushButton:checked {
    background-color: #007AFF;
    color: white;
}

QPushButton#GenerateButton {
    background-color: #007AFF;
    color: white;
}

QPushButton#GenerateButton:hover {
    background-color: #0056CC;
}

QLineEdit, QSpinBox, QDoubleSpinBox, QTextEdit, QPlainTextEdit {
    background-color: #E8E8ED;
    color: #1D1D1F;
    border: 1px solid #D1D1D6;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 2px solid #007AFF;
}

QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled {
    background-color: #F5F5F7;
    color: #AEAEB2;
}

QCheckBox {
    color: #1D1D1F;
}

QCheckBox::indicator {
    border: 1px solid #D1D1D6;
    background-color: #E8E8ED;
}

QCheckBox::indicator:checked {
    background-color: #007AFF;
    border-color: #007AFF;
}

QComboBox {
    background-color: #E8E8ED;
    color: #1D1D1F;
    border: 1px solid #D1D1D6;
}

QComboBox:hover {
    border-color: #C7C7CC;
}

QComboBox:focus {
    border: 2px solid #007AFF;
}

QComboBox QAbstractItemView {
    background-color: #E8E8ED;
    border: 1px solid #D1D1D6;
    selection-background-color: #007AFF;
}

QProgressBar {
    background-color: #E8E8ED;
}

QProgressBar::chunk {
    background-color: #007AFF;
}

QComboBox#NavigationBox {
    background-color: #F5F5F7;
}

QToolTip {
    background-color: #E8E8ED;
    color: #6E6E73;
    border: 1px solid #D1D1D6;
}

QPushButton#CollapsibleToggle {
    color: #1D1D1F;
    border-bottom-color: #D1D1D6;
}

QPushButton#CollapsibleToggle:hover {
    color: #007AFF;
}

QTabBar::tab {
    background-color: #E8E8ED;
    color: #6E6E73;
}

QTabBar::tab:selected {
    background-color: #007AFF;
    color: white;
}

QTabBar::tab:hover:!selected {
    background-color: #D1D1D6;
}

QLabel#QueueStatusLabel {
    background-color: #F5F5F7;
    color: #6E6E73;
    border-color: #D1D1D6;
}

QLabel#ConnectionBanner {
    background-color: #F5F5F7;
    color: #6E6E73;
    border-color: #D1D1D6;
}

QPushButton#ClearQueueButton {
    background-color: transparent;
    color: #6E6E73;
    border-color: #D1D1D6;
}

QPushButton#ClearQueueButton:hover {
    color: #FF453A;
    border-color: #FF453A;
}
*/
