/* ═══════════════════════════════════════════════════════════════════
   Apple-Grade Minimal Premium UI — Dark Mode Default
   ═══════════════════════════════════════════════════════════════════
   
   Design Tokens (Dark Theme):
   --bg-primary:    #0B0B0C   (deepest background)
   --bg-secondary:  #121214   (card/panel background)
   --bg-tertiary:   #1A1A1F   (input/field background)
   --bg-elevated:   #2A2A33   (elevated elements, scrollbar handles)
   --bg-hover:      #3A3A45   (hover state)
   --text-primary:  #F5F5F7   (primary text)
   --text-secondary:#A1A1AA   (secondary text)
   --text-disabled: #555555   (disabled text)
   --accent:        #0A84FF   (primary accent)
   --accent-hover:  #0070E0   (accent hover)
   --accent-active: #005ABB   (accent pressed)
   --border:        #2A2A33   (default border)
   --border-focus:  #0A84FF   (focus ring)
   --radius-sm:     6px       (small radius)
   --radius-md:     10px      (medium radius)
   --radius-lg:     12px      (large radius)
   --spacing-xs:    4px       (extra small)
   --spacing-sm:    8px       (small)
   --spacing-md:    16px      (medium)
   --spacing-lg:    24px      (large)
   --spacing-xl:    32px      (extra large)
   ═══════════════════════════════════════════════════════════════════ */

/* Global Settings */
QWidget {
    background-color: #0B0B0C;
    color: #F5F5F7;
    font-family: ".AppleSystemUIFont", "San Francisco", "Segoe UI", sans-serif;
    font-size: 14px;
    border: none;
    outline: none;
}

/* Scrollbars */
QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 10px;
    margin: 0px 0px 0px 0px;
}

QScrollBar::handle:vertical {
    background: #2A2A33;
    min-height: 20px;
    border-radius: 5px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    border: none;
    background: transparent;
    height: 10px;
    margin: 0px 0px 0px 0px;
}

QScrollBar::handle:horizontal {
    background: #2A2A33;
    min-width: 20px;
    border-radius: 5px;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* Tab Bar (Task 29: QTabBar replacement) */
QTabWidget::pane {
    border: none;
    background-color: transparent;
}

QTabBar {
    background-color: transparent;
    border: none;
}

QTabBar::tab {
    background-color: #1A1A1F;
    color: #A1A1AA;
    padding: 8px 16px;
    border: none;
    border-radius: 8px;
    margin: 2px;
    font-weight: 500;
}

QTabBar::tab:selected {
    background-color: #0A84FF;
    color: white;
    font-weight: 600;
}

QTabBar::tab:hover:!selected {
    background-color: #2A2A33;
}

QTabBar::tab:pressed {
    background-color: #121214;
}

QTabBar::tab:disabled {
    background-color: #121214;
    color: #555555;
}

/* Layouts and Spacing */
QVBoxLayout, QHBoxLayout, QFormLayout {
    spacing: 16px;
    margin: 16px;
}

/* GroupBox (Cards) */
QGroupBox {
    background-color: #121214;
    border: 1px solid #2A2A33;
    border-radius: 12px;
    margin-top: 24px;
    padding: 16px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 4px;
    color: #F5F5F7;
    font-size: 16px;
    font-weight: 600;
}

QGroupBox:disabled {
    background-color: #0B0B0C;
}

QGroupBox:disabled::title {
    color: #555555;
}

/* Labels */
QLabel {
    color: #A1A1AA;
    font-size: 14px;
}

QLabel:disabled {
    color: #555555;
}

/* Buttons */
QPushButton {
    background-color: #2A2A33;
    color: #F5F5F7;
    border: 1px solid #2A2A33;
    border-radius: 10px;
    padding: 8px 16px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #3A3A45;
}

QPushButton:pressed {
    background-color: #1A1A1F;
}

QPushButton:checked {
    background-color: #0A84FF;
    color: white;
}

QPushButton:checked:hover {
    background-color: #0A84FF;
}

QPushButton:focus {
    border: 2px solid #0A84FF;
    padding: 6px 14px;
}

QPushButton:disabled {
    background-color: #121214;
    color: #555555;
    border: 1px solid #1A1A1F;
}

/* Primary "Generate" Button styling hook */
QPushButton#GenerateButton {
    background-color: #0A84FF;
    color: white;
    font-weight: 600;
    font-size: 16px;
    padding: 12px 24px;
}

QPushButton#GenerateButton:hover {
    background-color: #0070E0;
}

QPushButton#GenerateButton:pressed {
    background-color: #005ABB;
}

QPushButton#GenerateButton:focus {
    border: 2px solid #0070E0;
    padding: 10px 22px;
}

QPushButton#GenerateButton:disabled {
    background-color: #1A1A1F;
    color: #555555;
    border: 1px solid #2A2A33;
}

/* Inputs */
QLineEdit, QSpinBox, QDoubleSpinBox, QTextEdit, QPlainTextEdit {
    background-color: #1A1A1F;
    color: #F5F5F7;
    border: 1px solid #2A2A33;
    border-radius: 10px;
    padding: 8px 12px;
    selection-background-color: #0A84FF;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 2px solid #0A84FF;
    padding: 7px 11px;
}

QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled, QTextEdit:disabled, QPlainTextEdit:disabled {
    background-color: #121214;
    color: #555555;
    border: 1px solid #1A1A1F;
}

/* QSpinBox buttons hidden for minimal UI */
QSpinBox::up-button, QSpinBox::down-button, QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
    width: 0px;
}

/* CheckBox */
QCheckBox {
    color: #F5F5F7;
    spacing: 8px;
}

QCheckBox:disabled {
    color: #555555;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 1px solid #2A2A33;
    background-color: #1A1A1F;
}

QCheckBox::indicator:hover {
    border: 1px solid #0A84FF;
}

QCheckBox::indicator:checked {
    background-color: #0A84FF;
    border: 1px solid #0A84FF;
    image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='white' stroke-width='4' stroke-linecap='round' stroke-linejoin='round'><polyline points='20 6 9 17 4 12'></polyline></svg>");
}

QCheckBox::indicator:disabled {
    background-color: #121214;
    border: 1px solid #2A2A33;
}

QCheckBox::indicator:focus {
    border: 2px solid #0A84FF;
}

/* ComboBox */
QComboBox {
    background-color: #1A1A1F;
    color: #F5F5F7;
    border: 1px solid #2A2A33;
    border-radius: 10px;
    padding: 8px 12px;
    combobox-popup: 0;
}

QComboBox:hover {
    border: 1px solid #3A3A45;
}

QComboBox:focus {
    border: 2px solid #0A84FF;
    padding: 7px 11px;
}

QComboBox:disabled {
    background-color: #121214;
    color: #555555;
    border: 1px solid #1A1A1F;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border-left-width: 0px;
}

QComboBox QAbstractItemView {
    background-color: #1A1A1F;
    border: 1px solid #2A2A33;
    border-radius: 8px;
    selection-background-color: #0A84FF;
    padding: 4px;
    outline: none;
}

/* Progress Bar */
QProgressBar {
    background-color: #1A1A1F;
    border: none;
    border-radius: 4px;
    height: 8px;
    text-align: center;
    color: transparent;
}

QProgressBar::chunk {
    background-color: #0A84FF;
    border-radius: 4px;
}

QProgressBar:disabled {
    background-color: #121214;
}

QProgressBar:disabled::chunk {
    background-color: #2A2A33;
}

/* Tabs or Combobox nav */
QComboBox#NavigationBox {
    background-color: #121214;
    border: none;
    font-size: 16px;
    font-weight: 600;
    padding: 12px 16px;
    border-radius: 12px;
    margin-bottom: 8px;
}

/* Tooltips */
QToolTip {
    background-color: #1A1A1F;
    color: #A1A1AA;
    border: 1px solid #2A2A33;
    border-radius: 6px;
    padding: 8px;
    font-size: 12px;
}

/* Collapsible Toggles */
QPushButton#CollapsibleToggle {
    background-color: transparent;
    color: #F5F5F7;
    text-align: left;
    font-weight: 600;
    font-size: 16px;
    padding: 8px 4px;
    border: none;
    border-bottom: 1px solid #2A2A33;
    border-radius: 0px;
}

QPushButton#CollapsibleToggle:hover, QPushButton#CollapsibleToggle:checked:hover {
    background-color: transparent;
    color: #0A84FF;
}

QPushButton#CollapsibleToggle:pressed, QPushButton#CollapsibleToggle:checked {
    background-color: transparent;
    color: #F5F5F7;
}

QPushButton#CollapsibleToggle:focus {
    border: 2px solid #0A84FF;
    padding: 6px 2px;
}

QPushButton#CollapsibleToggle:disabled {
    color: #555555;
    border-bottom-color: #1A1A1F;
}

/* ═══════════════════════════════════════════════════════════════════
   Queue Status Styling (Task 33)
   ═══════════════════════════════════════════════════════════════════ */

/* Queue Status Label */
QLabel#QueueStatusLabel {
    background-color: #121214;
    color: #A1A1AA;
    border: 1px solid #2A2A33;
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 13px;
}

QLabel#QueueStatusLabel[active="true"] {
    background-color: #1A1A1F;
    color: #0A84FF;
    border-color: #0A84FF;
}

QLabel#QueueStatusLabel[status="error"] {
    background-color: #1A1A1F;
    color: #FF453A;
    border-color: #FF453A;
}

QLabel#QueueStatusLabel[status="success"] {
    background-color: #1A1A1F;
    color: #30D158;
    border-color: #30D158;
}

/* Clear Queue Button */
QPushButton#ClearQueueButton {
    background-color: transparent;
    color: #A1A1AA;
    border: 1px solid #2A2A33;
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 12px;
}

QPushButton#ClearQueueButton:hover {
    background-color: #1A1A1F;
    color: #FF453A;
    border-color: #FF453A;
}

QPushButton#ClearQueueButton:pressed {
    background-color: #2A2A33;
}

QPushButton#ClearQueueButton:disabled {
    color: #555555;
    border-color: #1A1A1F;
}

/* ═══════════════════════════════════════════════════════════════════
   Connection Banner Styling
   ═══════════════════════════════════════════════════════════════════ */

QLabel#ConnectionBanner {
    background-color: #121214;
    color: #A1A1AA;
    border: 1px solid #2A2A33;
    border-radius: 10px;
    padding: 12px 16px;
    font-size: 13px;
}

QLabel#ConnectionBanner[connected="true"] {
    background-color: #121214;
    color: #30D158;
    border-color: #30D158;
}

QLabel#ConnectionBanner[connected="false"] {
    background-color: #1A1A1F;
    color: #FF453A;
    border-color: #FF453A;
}

/* ═══════════════════════════════════════════════════════════════════
   Light Theme Override Section
   ═══════════════════════════════════════════════════════════════════
   
   Qt does not natively support CSS media queries or theme detection
   in QSS. To enable light theme, uncomment the block below and 
   comment out the dark theme colors above.
   
   Design Tokens (Light Theme):
   --bg-primary:    #FFFFFF   (deepest background)
   --bg-secondary:  #F5F5F7   (card/panel background)
   --bg-tertiary:   #E8E8ED   (input/field background)
   --bg-elevated:   #D1D1D6   (elevated elements)
   --bg-hover:      #C7C7CC   (hover state)
   --text-primary:  #1D1D1F   (primary text)
   --text-secondary:#6E6E73   (secondary text)
   --text-disabled: #AEAEB2   (disabled text)
   --accent:        #007AFF   (primary accent)
   --accent-hover:  #0056CC   (accent hover)
   --accent-active: #003D99   (accent pressed)
   --border:        #D1D1D6   (default border)
   --border-focus:  #007AFF   (focus ring)
   
   ═══════════════════════════════════════════════════════════════════

/*
// Light Theme Overrides - Uncomment to activate

QWidget {
    background-color: #FFFFFF;
    color: #1D1D1F;
}

QScrollBar::handle:vertical {
    background: #D1D1D6;
}

QScrollBar::handle:horizontal {
